{
  "manifest_version": 3,
  "name": "Benchwarmers for YouTube",
  "version": "0.1.0",
  "description": "Your local Benchwarmers crew alongside YouTube. Uses the live party backend, not video-derived scores.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Benchwarmers" },
  "content_scripts": [{ "matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle" }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:3001" }
}
