{
  "name": "@benchwarmers/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "cross-env SPEED=4 tsx watch src/index.ts",
    "dev:overlay": "cross-env AI_MODE=fallback ASSISTANT_MODE=offline SPEED=1 DATA_FILE=data/overlay-session.json tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "pretest": "npm run build:widget",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && npm run typecheck:widget",
    "play": "tsx scripts/play-party.ts",
    "build:widget": "vite build --config src/mcp/widget/vite.config.ts",
    "typecheck:widget": "tsc -p src/mcp/widget/tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  }
}
