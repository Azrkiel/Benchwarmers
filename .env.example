# Server
PORT=3001
# Game speed multiplier: game seconds per real second (demo: 4)
SPEED=4
# Bearer token MCP clients must send (Authorization: Bearer <MCP_TOKEN>)
MCP_TOKEN=dev-token-change-me
# Where the JSON store lives
DATA_FILE=data/store.json

# AI content: fallback (committed content, no network) | gemini | bedrock
AI_MODE=fallback
AWS_REGION=us-east-1
# A Haiku-tier Claude inference profile id, e.g. us.anthropic.claude-haiku-...
BEDROCK_MODEL_ID=

# Assistant (simulated device): gemini | bedrock | offline (same MCP tools)
ASSISTANT_MODE=offline

# Gemini: set AI_MODE=gemini and/or ASSISTANT_MODE=gemini above.
# Paste ONE key here, OR use the comma-separated pool below.
GEMINI_API_KEY=
# Multiple teammate keys: key1,key2,key3 (keep current key after success).
# The pool takes precedence over GEMINI_API_KEY; failure triggers bounded failover.
GEMINI_API_KEYS=
GEMINI_MODEL_ID=gemini-3.8-flash
# Shared cooldown after quota/server/network failure; Google's longer delay wins.
GEMINI_KEY_COOLDOWN_MS=60000
# Overall deadline for one model request, including automatic key failover.
GEMINI_TIMEOUT_MS=60000
